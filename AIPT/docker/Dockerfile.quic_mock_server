# docker/Dockerfile.quic_mock_server -- QUIC idle-probe spike echo server
# (aipt/backends/quic_mock/, DESIGN.md "QUIC idle-probe spike" section).
#
# Mirrors docker/Dockerfile.mockserver's topology posture (net-backend
# only, reachable via `gateway`) but runs the aioquic-based echo server
# instead of the HTTP/1.1 inference-mock. This is a measurement spike, not
# yet a real Backend implementation -- see aipt/backends/quic_mock/
# __init__.py's module docstring for exactly what is/isn't wired up.
#
# A self-signed TLS cert/key is generated at *build* time (QUIC mandates
# TLS 1.3) -- fine for a loopback/Docker-internal spike; never do this for
# anything internet-facing.

FROM python:3.12-slim

WORKDIR /app

# iproute2: same `ip route add` need as Dockerfile.mockserver (DESIGN.md
# 4.7 확정 설계 1). openssl: self-signed cert generation for QUIC's
# mandatory TLS 1.3.
RUN apt-get update \
    && apt-get install -y --no-install-recommends iproute2 openssl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY aipt ./aipt

# [quic] extra installs aioquic; base `requests` dependency still pulled in
# transitively (aipt.core.wire imports it unconditionally, same reasoning
# as Dockerfile.mockserver).
RUN pip install --no-cache-dir ".[quic]"

RUN mkdir -p /app/quic_cert \
    && openssl req -x509 -newkey rsa:2048 -keyout /app/quic_cert/key.pem \
       -out /app/quic_cert/cert.pem -days 3650 -nodes -subj "/CN=quic-mock-server"

COPY docker/entrypoint_quic_mock_server.py ./entrypoint_quic_mock_server.py

ENV QUIC_MOCK_HOST=0.0.0.0 \
    QUIC_MOCK_PORT=4433 \
    QUIC_MOCK_CERT=/app/quic_cert/cert.pem \
    QUIC_MOCK_KEY=/app/quic_cert/key.pem

# UDP, not TCP -- QUIC rides on UDP.
EXPOSE 4433/udp

CMD ["python", "entrypoint_quic_mock_server.py"]
