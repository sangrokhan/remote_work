# docker/Dockerfile.mockserver -- AIPT mock-server container (DESIGN.md 4,
# 4.7 B10). Lightweight standalone process running
# aipt.backends.mock.server.Server (HTTP/1.1 keep-alive inference-mock,
# stdlib http.server only -- no FastAPI/uvicorn needed here, unlike
# Dockerfile.web/Dockerfile.gateway).
#
# aipt.backends.mock.server has no __main__ entrypoint of its own (it's
# designed to be started in-process by MockBackend for the non-Docker run
# path) -- docker/entrypoint_mockserver.py supplies the standalone
# Server(host="0.0.0.0", port=8888).serve_forever() equivalent for this
# container.
#
# Per DESIGN.md 4.7's topology decision, this service is NOT exposed to the
# host network directly -- it's reachable only via the `gateway` service
# (see docker-compose.yml's port mapping / TODO comments), which is where
# tc netem delay/jitter/loss/reorder injection happens (aipt/gateway/,
# Dockerfile.gateway) for the client<->mock-server path.

FROM python:3.12-slim

WORKDIR /app

# iproute2 provides the `ip` binary entrypoint_mockserver.py needs for
# `ip route add <net-client subnet> via <gateway IP>` (DESIGN.md 4.7 확정
# 설계 1). Without it, the route-add step silently no-ops (entrypoint
# treats a missing `ip` binary as non-fatal, matching the "report, don't
# crash" contract) and mock-server's replies never make it back through
# `gateway` -- this was caught by an actual `docker compose up` run: `ip`
# was missing from this image, the route was never added, and the
# response leg used the network's own kernel default route (out via the
# net-backend gateway's own IP) instead of being forced through the AIPT
# `gateway` service.
RUN apt-get update \
    && apt-get install -y --no-install-recommends iproute2 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY aipt ./aipt

# aipt.backends.mock.server itself is stdlib-only, but importing the aipt
# package pulls in aipt.core.wire, which imports `requests` unconditionally
# (see pyproject.toml's own comment on this) -- so requests (a base,
# non-optional dependency) must still be installed even for this minimal
# image. No [web]/[export] extras needed: this container never touches
# FastAPI, uvicorn, or pcap parsing.
RUN pip install --no-cache-dir .

# entrypoint_mockserver.py: adds an explicit `ip route add` to net-client
# via the gateway container before starting the mock server (DESIGN.md
# 4.7 확정 설계 1 -- forces response traffic back through `gateway`). No-op
# when GATEWAY_PEER_SUBNET/GATEWAY_ROUTE_VIA are unset.
COPY docker/entrypoint_mockserver.py ./entrypoint_mockserver.py

# MOCK_HOST/MOCK_PORT: entrypoint_mockserver.py's bind address (8888, the
# synthetic_mock/tcp_congestion convention preserved by DESIGN.md 4).
ENV MOCK_HOST=0.0.0.0 \
    MOCK_PORT=8888

EXPOSE 8888

CMD ["python", "entrypoint_mockserver.py"]
