# docker/Dockerfile.local_llm -- AIPT local-llm engine container.
#
# Wraps the upstream ghcr.io/ggml-org/llama.cpp:server image (real
# llama-server binary, OpenAI-compatible /v1/chat/completions) -- this
# project never reimplements inference (aipt/backends/local_llm/
# engine_adapter.py's explicit stance). We only add iproute2 (for the
# L3-routing `ip route add` DESIGN.md 4.7 확정 설계 1 requires, same reason
# docker/Dockerfile.mockserver needs it) and a thin entrypoint that does
# that routing fix-up before exec'ing the real llama-server.
#
# Port convention: 40080 (AIPT "local_llm lab uses the 40000s" convention),
# distinct from mock-server:8888, gateway:8080, web:10000 -- avoids any
# collision with a host-run engine a developer might have on the classic
# llama-server default of 8080 (see scripts/run_local_llm_engine.sh, which
# also defaults to 40080 now for the same reason).

FROM ghcr.io/ggml-org/llama.cpp:server

WORKDIR /app

# iproute2: the `ip` binary entrypoint_local_llm.py needs for
# `ip route add <net-client subnet> via <gateway IP>` (DESIGN.md 4.7 확정
# 설계 1). Missing it silently no-ops the route (entrypoint treats it as
# non-fatal), same posture as Dockerfile.mockserver.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends iproute2 \
    && rm -rf /var/lib/apt/lists/*

COPY docker/entrypoint_local_llm.py /app/entrypoint_local_llm.py
COPY docker/engine_gateway.py /app/engine_gateway.py
# Minimal `aipt` package slice for engine_gateway.py's
# `from aipt.core import cache_protocol` -- this image wraps upstream
# llama-server and deliberately does not install the full aipt package
# (its dependencies are irrelevant here); aipt/__init__.py and
# aipt/core/__init__.py are docstring-only (no imports of their own), so
# copying just the package-marker files plus cache_protocol.py is enough
# to make the import resolve without pulling in requests/fastapi/etc.
COPY aipt/__init__.py /app/aipt/__init__.py
COPY aipt/core/__init__.py /app/aipt/core/__init__.py
COPY aipt/core/cache_protocol.py /app/aipt/core/cache_protocol.py

ENV LLAMA_HOST=0.0.0.0 \
    LLAMA_PORT=40080 \
    MODEL_REPO=bartowski/Qwen2.5-0.5B-Instruct-GGUF:Q4_K_M \
    CTX_SIZE=4096 \
    ENGINE_GATEWAY_HOST=0.0.0.0 \
    ENGINE_GATEWAY_PORT=40079 \
    ENGINE_GATEWAY_UPSTREAM_HOST=127.0.0.1 \
    ENGINE_GATEWAY_UPSTREAM_PORT=40080 \
    ENGINE_GATEWAY_CACHE_THRESHOLD_BYTES=200

EXPOSE 40080 40079

# The base image (ghcr.io/ggml-org/llama.cpp:server) ships its own
# HEALTHCHECK hardcoded to the classic llama-server default port 8080.
# This project runs the engine on 40080 instead (see the port-convention
# comment above), so that inherited healthcheck always fails even when
# the engine is serving correctly -- `docker compose ps` reports
# "unhealthy" while `curl 127.0.0.1:40080/health` returns `{"status":"ok"}`.
# Override it to point at the actual port (found + fixed during the
# 2026-09-01 ooo end-to-end verification of the local_llm backend).
HEALTHCHECK --interval=5s --timeout=2s --start-period=60s --retries=3 \
    CMD curl -sf http://127.0.0.1:40080/health || exit 1

ENTRYPOINT ["python3", "/app/entrypoint_local_llm.py"]
