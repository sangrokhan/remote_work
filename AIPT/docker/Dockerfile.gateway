# docker/Dockerfile.gateway -- AIPT Network Gateway container (DESIGN.md
# 4.7, B9/B10). A standalone container running aipt.gateway.app, sitting
# on the network path between the client and mock-server/local-llm so it
# can inject L3/L4 traffic characteristics (tc netem: delay/jitter/loss/
# reorder/duplicate) via runtime profile switches
# (POST /gateway/profile). Not aipt/web -- that stays a separate image.
#
# *** REQUIRES CAP_NET_ADMIN AT RUNTIME ***
# `tc qdisc` commands need NET_ADMIN inside the container's network
# namespace. This Dockerfile only installs the tooling (iproute2) --
# granting the capability is a docker run/compose concern:
#   docker run --cap-add=NET_ADMIN ...
#   docker-compose.yml:  cap_add: ["NET_ADMIN"]
# Without it, aipt.gateway.netem_control reports {"ok": false, "reason":
# "... CAP_NET_ADMIN ..."} rather than crashing (see that module's
# docstring) -- so the image itself always builds and runs; only actual
# netem application needs the grant. Wiring that into docker-compose.yml
# is DESIGN.md B10, a separate task, out of scope here.
#
# *** ALSO REQUIRES net.ipv4.ip_forward=1 ***
# DESIGN.md 4.7 확정 설계 1: this container is a pure kernel L3 IP-forwarding
# hop between the `net-client` and `net-backend` Docker bridge networks --
# no application-level proxy code. The forwarding sysctl itself is set via
# docker-compose.yml's `sysctls: [net.ipv4.ip_forward=1]` on this service
# (Dockerfile ENV cannot set kernel sysctls). aipt.gateway.forwarding checks
# at runtime whether it actually took effect and reports the truth via
# GET /health rather than assuming the compose file's intent held.

FROM python:3.12-slim

# iproute2 provides the `tc` binary this whole container exists to call
# (and `ip link add ... type ifb` for the ingress-shaping workaround --
# 2026-09 client-link-only redesign, aipt.gateway.netem_control module
# docstring: tc netem only ever shapes egress, so the client_iface's
# ingress -- the request leg, client -> Gateway -- is redirected to an IFB
# device and shaped there). kmod lets the container `modprobe ifb` if the
# host kernel has the module built as a loadable module rather than
# built-in; if the host's kernel lacks CONFIG_IFB entirely, ingress
# shaping reports {"ok": false, "reason": "... _NO_IFB ..."} same honest
# posture as the CAP_NET_ADMIN case (module docstring). fq (the child
# qdisc aipt.gateway.netem_control chains under netem for BBR pacing)
# ships in the kernel, not a userspace package -- nothing extra needed for
# it here.
RUN apt-get update \
    && apt-get install -y --no-install-recommends iproute2 kmod \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
COPY aipt ./aipt

# `web` extra brings in fastapi/uvicorn, reused here rather than defining
# a separate `gateway` extra (see pyproject.toml's own comment on this
# choice) -- the gateway app has no dependency the web app doesn't already
# declare.
RUN pip install --no-cache-dir ".[web]"

# ENV GATEWAY_IFACE: deprecated, kept as the default for
# GATEWAY_CLIENT_IFACE when that var is unset (backward compatibility).
# GATEWAY_CLIENT_IFACE / GATEWAY_BACKEND_IFACE: which of this container's
# two network interfaces (net-client, net-backend -- DESIGN.md 4.7 확정
# 설계 1) tc commands target for the client-facing vs backend-facing leg.
# Docker's interface attach order is not guaranteed, so docker-compose.yml
# should set these explicitly rather than relying on the eth0/eth1 default.
# GATEWAY_IFB_DEV: the IFB device client_iface's ingress is redirected to
# for ingress shaping (2026-09 client-link-only redesign) -- only the
# client-facing leg needs one, since only it carries the user-selected
# profile in both directions; the backend-facing leg is always the fixed
# ETHERNET_BASELINE and its ingress is left unshaped.
# GATEWAY_PROFILE / GATEWAY_DELAY_MS / GATEWAY_JITTER_MS / GATEWAY_LOSS_PCT
# / GATEWAY_REORDER_PCT: startup preset for the client-facing leg
# (aipt.gateway.profiles.from_env). The backend-facing leg ignores these
# entirely -- it always gets ETHERNET_BASELINE regardless.
ENV GATEWAY_IFACE=eth0 \
    GATEWAY_CLIENT_IFACE=eth0 \
    GATEWAY_BACKEND_IFACE=eth1 \
    GATEWAY_IFB_DEV=ifb0

EXPOSE 8080

CMD ["uvicorn", "aipt.gateway.app:app", "--host", "0.0.0.0", "--port", "8080"]
