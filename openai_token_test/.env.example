# Required
OPENAI_API_KEY=sk-...

# Optional — defaults shown.
#
# gpt-4.1-nano is the cheapest model that satisfies all three requirements:
# it is on both /v1/chat/completions and /v1/responses, automatic prompt caching
# applies to it, and it is NOT a reasoning model — so reasoning tokens are zero
# and the stateless arms never carry encrypted reasoning items, which would
# inflate the very bytes we are trying to measure.
#
# gpt-5-nano is nominally cheaper ($0.05 in) but its lowest reasoning effort is
# "minimal", not "none", so it cannot be silenced. gpt-4o-mini is the older,
# longer-lived alternative and costs more on every axis.
#
#   model          input / cached / output    reasoning        shutdown
#   gpt-4.1-nano   0.10 / 0.025 / 0.40        none (non-rsn)   2026-10-23
#   gpt-4o-mini    0.15 / 0.075 / 0.60        none (non-rsn)   —
#   gpt-5-nano     0.05 / 0.005 / 0.40        minimal, cannot disable
#   gpt-5.4-nano   0.20 / 0.02  / 1.25        effort=none      —
OPENAI_MODEL=gpt-4.1-nano

# Leave EMPTY for a non-reasoning model (gpt-4.1-nano, gpt-4o-mini). Sending a
# reasoning parameter to a model that has no reasoning step is a 400.
# Set to "none" only for a reasoning model that accepts it, e.g. gpt-5.4-nano.
OPENAI_REASONING_EFFORT=

OPENAI_MAX_OUTPUT_TOKENS=400
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=180

# Pricing used for the cost column, USD per million tokens (gpt-4.1-nano list price)
PRICE_INPUT=0.10
PRICE_CACHED_INPUT=0.025
PRICE_OUTPUT=0.40
