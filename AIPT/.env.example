# AIPT — .env.example
# Copy to .env and fill in as needed: `cp .env.example .env`
# docker compose reads .env automatically from the compose project root.

# --- PublicAIBackend (real Gemini/OpenAI calls, DESIGN.md 4.5) -------------
# Required only if you plan to run the "public_ai" backend from the web UI.
# Leave empty to use mock/local_llm only -- PublicAIBackend.ready() reports
# "not ready" rather than crashing when these are unset.
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Network Gateway container (DESIGN.md 4.7, B9/B10) ---------------------
# Interface `tc qdisc netem` targets inside the gateway container.
GATEWAY_IFACE=eth0
# Startup profile preset: clean | broadband | 3g | satellite | lossy | custom
GATEWAY_PROFILE=clean
# Only used when GATEWAY_PROFILE=custom (or as base values for a preset):
GATEWAY_DELAY_MS=0
GATEWAY_JITTER_MS=0
GATEWAY_LOSS_PCT=0
GATEWAY_REORDER_PCT=0

# --- LocalLLMBackend (DESIGN.md 4.5, B4) ------------------------------------
# The `local-llm` service in docker-compose.yml runs a real llama-server
# (ghcr.io/ggml-org/llama.cpp:server, no inference reimplemented) on port
# 40080 -- the 40000s, deliberately NOT llama-server's classic 8080 default
# (that's already `gateway`'s port in this stack). Leave LOCAL_LLM_ENGINE_URL
# empty to use that in-compose service automatically (web's default targets
# its fixed net-backend IP, 172.28.2.4, directly -- NOT the `local-llm`
# hostname: `web` is only on net-client, so Docker's embedded DNS can't
# resolve a net-backend-only name for it even though gateway's kernel
# forwarding still gets the packets there). Override only to point at a
# different engine, e.g. one you started on the host with
# scripts/run_local_llm_engine.sh (same 40080 default there too):
#   LOCAL_LLM_ENGINE_URL=http://host.docker.internal:40080
LOCAL_LLM_ENGINE_URL=
# Which model the in-compose local-llm service downloads from the HF Hub
# on first boot ("<hf-repo>:<quant>" shorthand, passed to `llama-server -hf`).
LOCAL_LLM_MODEL_REPO=bartowski/Qwen2.5-0.5B-Instruct-GGUF:Q4_K_M
LOCAL_LLM_CTX_SIZE=4096
# "llama_cpp" or "vllm" -- purely a label carried into run records.
LOCAL_LLM_ENGINE_KIND=llama_cpp
LOCAL_LLM_API_KEY=

# --- web service ------------------------------------------------------------
# Host port the web UI is published on (container always listens on 10000).
WEB_HOST_PORT=10000

# --- Public AI record persistence (DESIGN.md 4.7.1) -------------------------
# Only PublicAIBackend (real Gemini/OpenAI) run request/response JSON is
# persisted to disk, one file per exec_id at <dir>/<exec_id>.json. Everything
# else (cwnd/pcap/mock/local_llm turns, CSV) stays in-memory only (see
# aipt/web/store.py) -- download bundle.zip right after a run if you need it.
PUBLIC_AI_RECORDS_DIR=data/public_ai_records
