# Sample environment for the Gemini traffic experiment.
# Copy to .env and fill in.  (.env is gitignored; docker compose auto-loads it.)
#
#   cp .env.example .env
#
# Quickest start (no GCP, no quota): set GEMINI_MOCK=1 and ignore the rest.

# --- Build mirrors (optional; compose passes these as build args) ----------
# Base image registry mirror (empty = Docker Hub).
BASE_IMAGE=python:3.12-slim
# Internal/regional PyPI mirror (empty = pypi.org).
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
# Debian apt mirror server, scheme+host only (empty = deb.debian.org).
# e.g. http://mirror.example.com   (replaces deb.debian.org; paths kept)
APT_MIRROR=

# --- Gemini Developer API (required for live runs) -------------------------
# The only host this project calls: generativelanguage.googleapis.com, with an
# API key. Vertex/ADC is gone -- every arm runs on one host, one auth, one
# network path, or the latency numbers compare the path instead of the mechanism.
GEMINI_API_KEY=

# --- Mock mode (no key / no quota) -----------------------------------------
# 1 = synthetic responses; no API key needed.
GEMINI_MOCK=0

# --- Firestore history (optional; ADC, unrelated to the API calls) ----------
FIRESTORE_COLLECTION=gemini_runs
FIRESTORE_DATABASE=(default)
# 1 = skip Firestore, write local JSON only.
FIRESTORE_DISABLE=0

# --- Cost estimate ---------------------------------------------------------
GEMINI_PRICE_PER_TOKEN=0.0000001

# --- Packet capture (optional; local/Docker only, needs NET_RAW) -----------
# Leave PCAP_DIR unset to let the app pick: data/pcaps normally, a temp dir when
# the checkout lives under a dot-directory in $HOME. Ubuntu's tcpdump AppArmor
# profile denies @{HOME}/.*/** outright, so a repo under e.g. ~/.openclaw/ cannot
# host the pcaps -- tcpdump gets NET_RAW, then dies on the output file with a bare
# "Permission denied". Set it explicitly only to override that choice.
#PCAP_DIR=data/pcaps
PCAP_IFACE=any
# 1 = hide/disable the capture toggle.
PCAP_DISABLE=0

# --- Endpoint inspector (optional) -----------------------------------------
TRANSCRIPT_DIR=data/transcripts
# Max response-body bytes captured (1 MiB).
INSPECT_MAX_BODY=1048576

# --- Server ----------------------------------------------------------------
# Cloud Run sets PORT automatically; override locally if needed.
PORT=8080
