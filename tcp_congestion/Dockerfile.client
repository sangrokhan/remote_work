FROM python:3.12-slim

# iproute2: tc netem / ip link (netem)
# build-essential: gcc for the cwnd_monitor C helper
# tcpdump: packet capture
# ethtool: TSO/GSO/SG/GRO/LRO offload toggling (tcp_congestion.offload)
RUN apt-get update && apt-get install -y --no-install-recommends \
    iproute2 build-essential tcpdump ethtool \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml .
COPY tcp_congestion/ ./tcp_congestion/
COPY native/ ./native/
COPY templates/ ./templates/
COPY static/ ./static/

RUN pip install --no-cache-dir -e .
RUN cc -O2 -Wall -o native/cwnd_monitor native/cwnd_monitor.c

ENV WEB_HOST=0.0.0.0 \
    WEB_PORT=10000 \
    NETEM_DELAY_MS=0 \
    NETEM_IFACE=eth0 \
    TRAFFIC_PCAP_DIR=/app/data/pcaps

EXPOSE 10000

COPY entrypoint_client.py .
CMD ["python", "entrypoint_client.py"]
