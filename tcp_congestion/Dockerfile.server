FROM python:3.12-slim

# iproute2: tc netem / ip link
# build-essential: gcc for the cwnd_monitor C helper
# ethtool: TSO/GSO/SG/GRO/LRO offload toggling (tcp_congestion.offload)
RUN apt-get update && apt-get install -y --no-install-recommends \
    iproute2 build-essential ethtool \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml .
COPY tcp_congestion/ ./tcp_congestion/
COPY native/ ./native/

RUN pip install --no-cache-dir -e .
# Pre-build the cwnd monitor helper at image build time so the first request
# is not slowed by a compile.
RUN cc -O2 -Wall -o native/cwnd_monitor native/cwnd_monitor.c

ENV SERVER_HOST=0.0.0.0 \
    SERVER_PORT=8888 \
    NETEM_DELAY_MS=0 \
    NETEM_IFACE=eth0

EXPOSE 8888

COPY entrypoint_server.py .
CMD ["python", "entrypoint_server.py"]
